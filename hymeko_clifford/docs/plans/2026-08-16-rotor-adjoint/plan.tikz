% Cost of a k-angle gradient: central difference vs adjoint.
% Compile inside a tikzpicture-capable document, or \documentclass[tikz]{standalone}.
\begin{tikzpicture}[
  font=\small,
  box/.style={draw, rounded corners=2pt, minimum height=7mm, align=center,
              inner sep=3pt, fill=blue!6, draw=blue!45},
  cost/.style={draw, rounded corners=2pt, minimum height=7mm, align=center,
               inner sep=3pt, fill=orange!12, draw=orange!70},
  win/.style={draw, rounded corners=2pt, minimum height=7mm, align=center,
              inner sep=3pt, fill=green!8, draw=green!50!black},
  ar/.style={-latex, thick, draw=black!55},
  lbl/.style={font=\footnotesize\itshape, text=black!60},
]

% Forward sweep
\node[font=\bfseries] (t) at (0,0) {Forward sweep --- stored once, $O(k)$};
\node[box, below=5mm of t] (x0) {$x_0 = v$};
\node[box, right=9mm of x0] (x1) {$x_1$};
\node[box, right=9mm of x1] (x2) {$x_2$};
\node[right=6mm of x2] (dots) {$\cdots$};
\node[box, right=6mm of dots] (xk) {$x_k = w$};
\draw[ar] (x0) -- node[above,lbl] {$R_1$} (x1);
\draw[ar] (x1) -- node[above,lbl] {$R_2$} (x2);
\draw[ar] (x2) -- (dots);
\draw[ar] (dots) -- node[above,lbl] {$R_k$} (xk);

% Backward sweep
\node[font=\bfseries, below=16mm of t] (t2) {Backward sweep --- one pass, $O(k)$};
\node[win, below=5mm of t2] (a0) {$\bar a_0 = \partial L/\partial v$};
\node[win, right=9mm of a0] (a1) {$\bar a_1$};
\node[win, right=9mm of a1] (a2) {$\bar a_2$};
\node[right=6mm of a2] (dots2) {$\cdots$};
\node[win, right=6mm of dots2] (ak) {$\bar a_k = \partial L/\partial w$};
\draw[ar] (a1) -- node[below,lbl] {$\tilde R_1(\cdot)R_1$} (a0);
\draw[ar] (a2) -- node[below,lbl] {$\tilde R_2(\cdot)R_2$} (a1);
\draw[ar] (dots2) -- (a2);
\draw[ar] (ak) -- node[below,lbl] {$\tilde R_k(\cdot)R_k$} (dots2);

\node[lbl, below=3mm of a1, text width=52mm, align=center]
  {$\partial L/\partial\theta_i = \bar a_i \cdot (\omega_i \times x_i)$ \\ one cross product per angle};

% Cost comparison
\node[cost, below=30mm of t2.west, anchor=west, text width=52mm]
  (fd) {\textbf{central difference}\\ $2k$ forward sweeps $=2k^2$ rotor applications\\
        measured $63.9\times$ forward at $k=32$};
\node[win, right=10mm of fd, text width=52mm]
  (ad) {\textbf{adjoint}\\ $1$ forward $+1$ backward $=2k$ rotor applications\\
        target $\le 4\times$ forward};
\draw[ar] (fd) -- (ad);

\end{tikzpicture}
